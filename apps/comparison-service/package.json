{
  "name": "@nx-monorepo-comparisonsui/comparison-service",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "comparison-service",
    "targets": {
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": ["build"],
        "options": { "buildTarget": "comparison-service:build", "inspect": false, "runBuildTargetDependencies": false },
        "configurations": {
          "development": { "buildTarget": "comparison-service:build:development" },
          "production": { "buildTarget": "comparison-service:build:production" }
        }
      }
    },
    "tags": ["type:app", "scope:backend", "domain:correlation"]
  },
  "dependencies": {
    "@cui/network": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "mongodb": "^7.6.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.3.0",
    "typeorm": "^1.1.1"
  }
}
